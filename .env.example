# Codger Environment Configuration
# Copy this file to .env and fill in values as needed.
#
# NVIDIA_API_KEY is ONLY required if you want to run the benchmarks
# (benchmark-nvidia.py). The skill itself works without any API keys.
# Get a free key from https://build.nvidia.com
#
# NVIDIA_API_KEY=

# Optional: override the default NIM model used by benchmark-nvidia.py
# NIM_MODEL=meta/llama-3.3-70b-instruct

# Optional: override the default NIM base URL
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1